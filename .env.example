# ── Vite (browser) — copy these names into Vercel → Environment Variables ───
# Required in production (see DEPLOY.md). Missing vars show a config screen, not a blank page.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT or new publishable key (sb_publishable_…)
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Canonical app URL for Supabase Auth redirects in production.
VITE_PUBLIC_APP_URL=https://tipguardsa.co.za

# Staging demo mode (one-click login on /login after npm run seed:demo)
# VITE_DEMO_MODE=true
# VITE_DEMO_PASSWORD=TipGuardDemo2026!

# Optional: force Paystack test behaviour (inferred from pk_test_ if unset)
# VITE_PAYSTACK_TEST_MODE=true

# Optional: verbose payment invoke logs in browser console (also on in dev)
# VITE_DEBUG_PAY=true

# Optional: support email shown on /contact (default support@tipguard.co.za)
# VITE_SUPPORT_EMAIL=support@your-domain.com
# Paystack / POPIA public business details (production — replace placeholders)
# VITE_BUSINESS_LEGAL_NAME=TipGuard SA (Pty) Ltd
# VITE_BUSINESS_PHONE=+27 11 000 0000
# VITE_BUSINESS_ADDRESS=1 Example Rd, Johannesburg, 2000, South Africa

# Optional: Sentry error tracking (@sentry/react — no crash if unset)
# VITE_SENTRY_DSN=

# Emergency maintenance page (Vercel only; redeploy after change)
# VITE_MAINTENANCE_MODE=true

# Optional: analytics (no crash if unset; prefer Plausible for lightweight traffic)
# VITE_PLAUSIBLE_DOMAIN=tipguard.example.com
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://app.posthog.com

# Optional: push notifications (scaffold only — see docs/PUSH_NOTIFICATIONS.md)
# VITE_ENABLE_PUSH=false

# Optional: sign out after N minutes idle (0 or unset = disabled; 30 = on for admin)
# VITE_SESSION_IDLE_MINUTES=0
# VITE_SESSION_IDLE_MINUTES=30

# Checkout gateway: paystack | payfast | yoco | ozow | peach_payments
# VITE_TIP_PAYMENT_GATEWAY=paystack

# Planned gateways (placeholders until Edge functions ship)
# VITE_PAYFAST_MERCHANT_ID=
# VITE_YOCO_PUBLIC_KEY=
# VITE_OZOW_SITE_CODE=
# VITE_PEACH_ENTITY_ID=

# ── Supabase Edge (supabase secrets set — never in Vercel client env) ───────
# SUPABASE_URL              — injected by Supabase
# SUPABASE_ANON_KEY         — injected
# SUPABASE_SERVICE_ROLE_KEY — injected; also needed for npm run seed:demo
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# PAYSTACK_PAYOUT_TRANSFERS=true      # request-payout: Paystack Transfer API (false = manual only)
# PUBLIC_APP_URL=https://tipguardsa.co.za
# RESEND_API_KEY=re_xxxxxxxx          # notify-payment Edge (optional; omit until Resend verified)
# NOTIFY_FROM_EMAIL=payments@tipguard.co.za
# MAINTENANCE_MODE=true          # Edge: 503 on payment routes (Supabase secrets)
# APP_VERSION=1.0.0              # health function JSON

# ── Local scripts (seed-demo, verify-supabase) — same URL as VITE_* ─────────
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...  # Dashboard → Account → Access Tokens (for db:push:api + auth:configure)
# SUPABASE_PROJECT_REF=fyjmujhlqpvfryelnfum
# DEMO_PASSWORD=TipGuardDemo2026!
