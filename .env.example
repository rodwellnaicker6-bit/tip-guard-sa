# ── Vite (browser) — required for staging/production builds ─────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT or new publishable key (sb_publishable_…)
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Staging demo mode (one-click login on /login after npm run seed:demo)
# VITE_DEMO_MODE=true
# VITE_DEMO_PASSWORD=TipGuardDemo2026!

# Optional: force Paystack test behaviour (inferred from pk_test_ if unset)
# VITE_PAYSTACK_TEST_MODE=true

# Optional: Sentry DSN (stub init in src/lib/sentry.ts — add @sentry/react post-MVP)
# VITE_SENTRY_DSN=

# Optional: sign out after N minutes idle (0 or unset = disabled)
# VITE_SESSION_IDLE_MINUTES=30

# Checkout gateway: paystack | payfast | yoco | ozow | peach_payments
# VITE_TIP_PAYMENT_GATEWAY=paystack

# Planned gateways (placeholders until Edge functions ship)
# VITE_PAYFAST_MERCHANT_ID=
# VITE_YOCO_PUBLIC_KEY=
# VITE_OZOW_SITE_CODE=
# VITE_PEACH_ENTITY_ID=

# ── Supabase Edge (supabase secrets set — never in Vercel client env) ───────
# SUPABASE_URL              — injected by Supabase
# SUPABASE_ANON_KEY         — injected
# SUPABASE_SERVICE_ROLE_KEY — injected; also needed for npm run seed:demo
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# PUBLIC_APP_URL=https://your-staging.vercel.app

# ── Local scripts (seed-demo, verify-supabase) — same URL as VITE_* ─────────
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...  # Dashboard → Account → Access Tokens (for db:push:api + auth:configure)
# SUPABASE_PROJECT_REF=fyjmujhlqpvfryelnfum
# DEMO_PASSWORD=TipGuardDemo2026!
